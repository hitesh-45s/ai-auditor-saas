# ==============================================================================
# AUDITAI — ROOT & BACKEND ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env and fill in your actual credentials.
# NEVER commit your actual .env file with secrets to GitHub!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Supabase (Database, Auth & Storage)
# https://supabase.com/dashboard/project/_/settings/api
# ------------------------------------------------------------------------------
SUPABASE_URL="https://your-project-id.supabase.co"
SUPABASE_SERVICE_KEY="your-supabase-service-role-secret-key"

# Optional direct PostgreSQL connection string (Supabase Database Settings)
# DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-ID].supabase.co:5432/postgres"

# ------------------------------------------------------------------------------
# 2. Upstash Redis (Serverless Background Task Queue)
# https://console.upstash.com/
# ------------------------------------------------------------------------------
UPSTASH_REDIS_REST_URL="https://your-database-name.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your-upstash-rest-token"

# ------------------------------------------------------------------------------
# 3. Primary AI Model — Google Gemini
# Free API key: https://aistudio.google.com/app/apikey
# ------------------------------------------------------------------------------
GEMINI_API_KEY="your-gemini-api-key"

# ------------------------------------------------------------------------------
# 4. Secondary Backup AI — Groq (Multi-Model Failover)
# Free API key: https://console.groq.com/keys
# ------------------------------------------------------------------------------
GROQ_API_KEY="your-groq-api-key"

# ------------------------------------------------------------------------------
# 5. API Gateway URL
# ------------------------------------------------------------------------------
NEXT_PUBLIC_API_URL="http://localhost:8000"
